# Copy this file to .env for local development.
# None of these values are secret. They have working defaults in src/config/site.ts,
# so you only need to set them if you want to change something.

# Formspree endpoint for the contact form (https://formspree.io).
# Set to none to hide the form and show the email address instead.
PUBLIC_FORM_ENDPOINT=https://formspree.io/f/mbggzona

# Scheduling link used by every "Schedule a conversation" button.
PUBLIC_BOOKING_URL=https://calendly.com/samsaraventures/30min

# Founder LinkedIn profile. The link only appears once this is set.
PUBLIC_FOUNDER_LINKEDIN=

# Set to true to preview draft Insights articles locally. Never set this in production.
PUBLIC_SHOW_DRAFTS=false
