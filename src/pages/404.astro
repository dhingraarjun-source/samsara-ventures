---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { services } from '@/data/services';
---
<BaseLayout title="Page not found" description="The page you are looking for does not exist." noindex>
  <section class="section">
    <div class="container-site max-w-3xl">
      <p class="kicker">404</p>
      <h1 class="mt-4 text-h1">This page doesn’t exist.</h1>
      <p class="mt-6 text-lede text-ink-soft">The link may be out of date, or the page may have moved. These pages may help:</p>
      <ul class="rule-list mt-8 font-sans text-[1.1rem]">
        <li><a href="/">Home</a></li>
        {services.map((s) => <li><a href={s.href}>{s.name}</a></li>)}
        <li><a href="/contact/">Contact</a></li>
      </ul>
    </div>
  </section>
</BaseLayout>
