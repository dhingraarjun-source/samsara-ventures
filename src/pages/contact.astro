---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/PageHero.astro';
import ContactForm from '@/components/ContactForm.astro';
import { site } from '@/config/site';
import { breadcrumbSchema } from '@/utils/schema';

const crumbs = [{ name: 'Home', href: '/' }, { name: 'Contact', href: '/contact/' }];
---
<BaseLayout
  title="Contact Samsara Ventures"
  description="Speak with a senior M&A advisor about a transaction, separation, integration or transformation. Schedule a conversation or send a message."
  schema={[breadcrumbSchema(crumbs)]}
>
  <PageHero
    kicker="Contact"
    title="Let's Discuss Your Next Move."
    lede="Whether you're evaluating an acquisition, navigating a separation or accelerating business transformation, connect with Samsara Ventures to discuss how we can support your objectives."
    crumbs={crumbs}
  >
    <div class="mt-9 flex flex-wrap gap-3">
      <a href={site.bookingUrl} class="btn btn-primary" target="_blank" rel="noopener">Schedule a Conversation</a>
      <a href="#message" class="btn btn-outline">Send a message</a>
    </div>
  </PageHero>

  <section class="section" aria-label="Contact options">
    <div class="container-site grid gap-14 lg:grid-cols-12">
      <div id="message" class="lg:col-span-7">
        <h2 class="text-h2">Send a message</h2>
        <p class="mt-3 text-ink-soft">Tell us a little about your situation and we will get back to you.</p>
        <div class="mt-8">
          <ContactForm />
        </div>
      </div>

      <aside class="lg:col-span-4 lg:col-start-9" aria-label="Other ways to reach us">
        <div class="rounded-xl bg-ink p-8 text-white on-dark">
          <h2 class="font-sans text-[1.35rem] font-medium text-white">Prefer to talk?</h2>
          <p class="mt-3 text-white/75">Book a 30-minute introductory conversation at a time that suits you.</p>
          <a href={site.bookingUrl} class="btn btn-light mt-6 w-full" target="_blank" rel="noopener">Schedule a Conversation</a>
        </div>

        <dl class="mt-10 space-y-6 font-sans">
          <div>
            <dt class="text-[0.92rem] text-ink-muted">Email</dt>
            <dd class="mt-1 text-[1.1rem]"><a href={`mailto:${site.email}`}>{site.email}</a></dd>
          </div>
          <div>
            <dt class="text-[0.92rem] text-ink-muted">Location</dt>
            <dd class="mt-1 text-[1.1rem]">{site.location}</dd>
          </div>
          <div>
            <dt class="text-[0.92rem] text-ink-muted">Clients</dt>
            <dd class="mt-1 text-[1.1rem]">Across {site.serviceArea}</dd>
          </div>
        </dl>

        <div class="mt-10 border-t border-rule pt-6">
          <h3 class="font-sans text-base font-medium">What to expect</h3>
          <ul class="mt-3 space-y-2 text-[0.98rem] text-ink-soft">
            <li>A reply from a senior advisor</li>
            <li>Inquiries handled in confidence</li>
            <li>No obligation</li>
          </ul>
        </div>
      </aside>
    </div>
  </section>
</BaseLayout>
