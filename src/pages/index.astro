---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Wheel from '@/components/Wheel.astro';
import SectionHead from '@/components/SectionHead.astro';
import Testimonials from '@/components/Testimonials.astro';
import CTABand from '@/components/CTABand.astro';
import { services } from '@/data/services';
import { site } from '@/config/site';
import { getVisibleInsights, isLive } from '@/utils/insights';

const live = (await getVisibleInsights()).filter((a) => isLive(a)).slice(0, 3);
const core = services.filter((s) => s.primary);
const secondary = services.filter((s) => !s.primary);

const differentiators = [
  { title: 'Operational and technology depth', text: 'We focus on how the business runs day to day, including its systems, processes and shared services, which is where many deal costs and delays come from.' },
  { title: 'Senior expertise, directly delivered', text: 'The person who scopes your engagement does the work, from the first conversation through to delivery.' },
  { title: 'From diligence through execution', text: 'The same advisor can assess a target, plan the integration or separation, and lead delivery after close.' },
];
---
<BaseLayout
  title="Samsara Ventures | Boutique M&A Advisory & Value Creation"
  description="M&A advisory focused on operations and technology: IT and operational due diligence, integration, carve-outs and value creation for private equity firms and corporate acquirers."
  headerVariant="overlay"
>
  <!-- Hero -->
  <section class="on-red hero relative overflow-hidden bg-red text-white" aria-labelledby="hero-title">
    <div class="hero-wheel pointer-events-none absolute text-white">
      <Wheel spin class="h-full w-full" />
    </div>
    <div class="container-site relative pb-20 pt-36 md:pb-28 md:pt-48">
      <h1 id="hero-title" class="max-w-[15ch] text-display text-white">M&amp;A advisory built on operational and technology depth.</h1>
      <p class="mt-7 max-w-2xl text-lede text-white/90">
        We help private equity firms and corporate acquirers understand, integrate and separate the operations and technology behind a deal, then deliver the value creation plan that follows.
      </p>
      <div class="mt-9 flex flex-wrap gap-3">
        <a href="/contact/" class="btn btn-light">Speak With an Advisor</a>
        <a href="#expertise" class="btn btn-outline-light">Explore Our Expertise</a>
      </div>
      <p class="mt-12 max-w-xl border-t border-white/25 pt-6 font-sans text-[0.98rem] text-white/85">
        Led by <a href="/about/#founder" class="font-medium text-white underline decoration-white/50 underline-offset-4 hover:decoration-white">Arjun Dhingra</a>, who spent more than a decade on M&amp;A and transformation work at PwC, EY-Parthenon and Deloitte.
      </p>
    </div>
  </section>

  <!-- Expertise -->
  <section id="expertise" class="section" aria-labelledby="expertise-title">
    <div class="container-site">
      <SectionHead id="expertise-title" title="Our expertise" intro="For private equity firms, portfolio companies and corporate development teams, before and after a deal closes." />
      <div class="grid gap-10 md:grid-cols-2 md:gap-12">
        {core.map((s) => (
          <article class="flex flex-col border-t-[3px] border-red pt-6">
            <h3 class="text-[1.55rem]"><a href={s.href} class="text-ink no-underline hover:text-red">{s.name}</a></h3>
            <p class="mt-3 text-ink-soft">{s.summary}</p>
            <p class="mt-4 text-[0.98rem]"><span class="font-sans font-medium text-red">Call us when: </span>{s.trigger.charAt(0).toLowerCase() + s.trigger.slice(1)}</p>
            <a href={s.href} class="link-arrow mt-5" aria-label={`Learn more about ${s.name}`}>Learn more</a>
          </article>
        ))}
      </div>
      {secondary.map((s) => (
        <p class="mt-10 border-t border-rule pt-6 text-ink-soft">
          <span class="font-sans font-medium text-ink">Also: </span>
          <a href={s.href} class="link-arrow">{s.name}</a>, {s.summary.charAt(0).toLowerCase() + s.summary.slice(1)}
        </p>
      ))}
      <p class="mt-4 text-ink-soft">
        <a href="/experience/" class="link-arrow">See examples of our experience</a>
      </p>
    </div>
  </section>

  <!-- Why Samsara -->
  <section class="on-dark section relative overflow-hidden bg-ink text-white" aria-labelledby="why-title">
    <Wheel class="why-mark pointer-events-none absolute text-white" />
    <div class="container-site relative">
      <SectionHead id="why-title" title="Why Samsara" intro="Big Four transaction experience with a focus on operations and technology, delivered by a senior advisor." dark />
      <div class="grid gap-10 md:grid-cols-3">
        {differentiators.map((d) => (
          <div class="border-t border-white/20 pt-6">
            <h3 class="text-[1.4rem] text-white">{d.title}</h3>
            <p class="mt-3 text-white/75">{d.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <Testimonials />

  <!-- City image -->
  <figure class="relative">
    <img src="/img/skyline.jpg" alt="Lower Manhattan skyline at dusk, seen across the East River" width="2000" height="933" loading="lazy" decoding="async" class="h-[220px] w-full object-cover md:h-[400px]" style="object-position: 50% 45%;" />
    <figcaption class="container-site absolute inset-x-0 bottom-0 pb-5 font-sans text-[0.95rem] text-white/90 [text-shadow:0_1px_8px_rgb(0_0_0/.5)]">
      Based in {site.location}. Working with clients across {site.serviceArea}.
    </figcaption>
  </figure>

  {live.length > 0 && (
    <section class="section-tight" aria-labelledby="insights-title">
      <div class="container-site">
        <div class="flex flex-wrap items-baseline justify-between gap-4">
          <h2 id="insights-title" class="text-h2">Latest insights</h2>
          <a href="/insights/" class="link-arrow">All insights</a>
        </div>
        <ul class="mt-6 grid gap-x-10 md:grid-cols-3">
          {live.map((a) => (
            <li class="border-t border-rule py-5">
              <a href={`/insights/${a.id}/`} class="block font-sans text-[1.15rem] font-medium leading-snug text-ink no-underline hover:text-red">{a.data.title}</a>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}

  <CTABand />
</BaseLayout>

<style>
  .hero-wheel { width: 720px; height: 720px; right: -170px; top: 50%; transform: translateY(-45%); opacity: .15; }
  @media (max-width: 1024px) { .hero-wheel { width: 520px; height: 520px; right: -200px; opacity: .12; } }
  @media (max-width: 640px) { .hero-wheel { width: 380px; height: 380px; right: -170px; top: 30%; } }
  :global(.why-mark) { width: 560px; height: 560px; right: -200px; bottom: -220px; opacity: .04; }
</style>
