---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Wheel from '@/components/Wheel.astro';
import SectionHead from '@/components/SectionHead.astro';
import ApproachFlow from '@/components/ApproachFlow.astro';
import CTABand from '@/components/CTABand.astro';
import { services } from '@/data/services';
import { site } from '@/config/site';
import { getVisibleInsights, isLive } from '@/utils/insights';

const live = (await getVisibleInsights()).filter((a) => isLive(a)).slice(0, 3);

const audiences = [
  'Private equity firms and their portfolio companies',
  'Corporate development and M&A executives',
  'C-suite leaders navigating complex transformations',
  'Organizations that need experienced, hands-on execution leadership',
];

const differentiators = [
  { title: 'Senior expertise, directly delivered', text: 'You work with an experienced advisor from the first conversation through to delivery, rather than being handed off to a junior team.' },
  { title: 'Flexible, tailored engagements', text: 'We shape each engagement around your goals, timeline and team, whether you need a short diligence project or longer program leadership.' },
  { title: 'Strategy through execution', text: 'We make practical recommendations and can stay on to help put them in place alongside your team.' },
];
---
<BaseLayout
  title="Samsara Ventures | Boutique M&A Advisory & Value Creation"
  description="Senior-led M&A advisory for private equity firms and corporate leaders: IT due diligence, integration, carve-outs, value creation and transformation."
  headerVariant="overlay"
>
  <!-- Hero -->
  <section class="on-red hero relative overflow-hidden bg-red text-white" aria-labelledby="hero-title">
    <div class="hero-wheel pointer-events-none absolute text-white">
      <Wheel spin class="h-full w-full" />
    </div>
    <div class="container-site relative pb-24 pt-40 md:pb-32 md:pt-48">
      <h1 id="hero-title" class="max-w-[13ch] text-display text-white">Senior M&amp;A Advisory. From Strategy to Execution.</h1>
      <p class="mt-8 max-w-2xl text-lede text-white/90">
        Samsara Ventures partners with private equity firms and corporate leaders to navigate complex transactions, accelerate value creation and execute critical business transformations.
      </p>
      <div class="mt-10 flex flex-wrap gap-3">
        <a href="/contact/" class="btn btn-light">Speak With an Advisor</a>
        <a href="#expertise" class="btn btn-outline-light">Explore Our Expertise</a>
      </div>
      <p class="mt-14 max-w-xl border-t border-white/25 pt-6 font-sans text-[0.98rem] text-white/80">
        Led by an advisor with more than a decade of M&amp;A and transformation experience at PwC, EY-Parthenon and Deloitte.
      </p>
    </div>
  </section>

  <!-- Who we are -->
  <section class="section" aria-labelledby="who-title">
    <div class="container-site grid gap-12 md:grid-cols-12">
      <div class="md:col-span-6">
        <p class="kicker">Who we are</p>
        <h2 id="who-title" class="mt-4 text-h2">A boutique advisory firm that combines strategic insight with execution.</h2>
        <p class="mt-6 text-ink-soft">
          We started Samsara Ventures so that clients could work directly with an experienced advisor throughout an engagement. The person you speak with at the start is the person doing the work, and that person has led transactions, integrations, separations and transformations at large advisory firms.
        </p>
        <p class="mt-4 text-ink-soft">
          Because we are small, we can be flexible about how we help. That might be a focused diligence project, running an integration program, or working inside a portfolio company on its value creation plan.
        </p>
        <a href="/about/" class="link-arrow mt-6 inline-block">More about the firm</a>
      </div>
      <div class="md:col-span-5 md:col-start-8">
        <h3 class="text-h3">Who we work with</h3>
        <ul class="rule-list mt-5">
          {audiences.map((a) => <li>{a}</li>)}
        </ul>
      </div>
    </div>
  </section>

  <!-- Expertise -->
  <section id="expertise" class="section bg-stone" aria-labelledby="expertise-title">
    <div class="container-site">
      <SectionHead id="expertise-title" title="Our expertise" intro="We work in three areas, covering the period before a deal is signed through integration, value creation and growth." />
      <div class="grid gap-12 md:grid-cols-3 md:gap-10">
        {services.map((s) => (
          <article class="pillar flex flex-col border-t-[3px] border-red pt-6">
            <h3 class="text-[1.55rem]"><a href={s.href} class="text-ink no-underline hover:text-red">{s.name}</a></h3>
            <p class="mt-3 text-[1rem] text-ink-soft">{s.summary}</p>
            <ul class="rule-list mt-6 flex-1 text-[0.98rem]">
              {s.highlights.map((h) => <li class="py-2.5">{h}</li>)}
            </ul>
            <a href={s.href} class="link-arrow mt-6" aria-label={`Learn more about ${s.name}`}>Learn more</a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Why Samsara -->
  <section class="on-dark section relative overflow-hidden bg-ink text-white" aria-labelledby="why-title">
    <Wheel class="why-mark pointer-events-none absolute text-white" />
    <div class="container-site relative">
      <SectionHead id="why-title" title="Why Samsara" intro="Big Four-caliber experience, delivered through a flexible, senior-led advisory model." dark />
      <div class="grid gap-12 md:grid-cols-3 md:gap-10">
        {differentiators.map((d, i) => (
          <div class="border-t border-white/20 pt-8">
            <span class="font-sans text-[2.6rem] font-light leading-none text-red-soft">{String(i + 1).padStart(2, '0')}</span>
            <h3 class="mt-6 text-[1.5rem] text-white">{d.title}</h3>
            <p class="mt-4 text-white/75">{d.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Approach -->
  <section class="section" aria-labelledby="approach-title">
    <div class="container-site">
      <SectionHead id="approach-title" title="Our approach" intro="This is how we usually run an engagement. The details vary with each deal and team, but these four steps are a good guide to what to expect." />
      <ApproachFlow />
    </div>
  </section>

  <!-- City image -->
  <figure class="relative">
    <img src="/img/skyline.jpg" alt="Lower Manhattan skyline at dusk, seen across the East River" width="2000" height="933" loading="lazy" decoding="async" class="h-[300px] w-full object-cover md:h-[440px]" style="object-position: 50% 45%;" />
    <figcaption class="container-site absolute inset-x-0 bottom-0 pb-6 font-sans text-[0.95rem] text-white/90 [text-shadow:0_1px_8px_rgb(0_0_0/.5)]">
      Based in {site.location}. Working with clients across {site.serviceArea}.
    </figcaption>
  </figure>

  {live.length > 0 && (
    <section class="section" aria-labelledby="insights-title">
      <div class="container-site">
        <SectionHead id="insights-title" title="Latest insights" intro="Perspectives on transactions, value creation and transformation." />
        <ul class="grid gap-x-10 md:grid-cols-3">
          {live.map((a) => (
            <li class="border-t border-rule py-6">
              <p class="font-sans text-[0.9rem] text-red">{a.data.category}</p>
              <a href={`/insights/${a.id}/`} class="mt-2 block font-sans text-[1.25rem] font-medium leading-snug text-ink no-underline hover:text-red">{a.data.title}</a>
            </li>
          ))}
        </ul>
        <a href="/insights/" class="link-arrow mt-8 inline-block">All insights</a>
      </div>
    </section>
  )}

  <CTABand />
</BaseLayout>

<style>
  .hero-wheel { width: 720px; height: 720px; right: -170px; top: 50%; transform: translateY(-45%); opacity: .15; }
  @media (max-width: 1024px) { .hero-wheel { width: 520px; height: 520px; right: -200px; opacity: .12; } }
  @media (max-width: 640px) { .hero-wheel { width: 380px; height: 380px; right: -170px; top: 30%; } }
  :global(.why-mark) { width: 560px; height: 560px; right: -200px; bottom: -220px; opacity: .04; }
</style>
