---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/PageHero.astro';
import CTABand from '@/components/CTABand.astro';
import { experienceGroups, industries } from '@/data/experience';
import { services } from '@/data/services';
import { site } from '@/config/site';
import { breadcrumbSchema } from '@/utils/schema';

const crumbs = [{ name: 'Home', href: '/' }, { name: 'Experience', href: '/experience/' }];
const label = { samsara: 'Samsara Ventures engagement', prior: 'Founder’s prior experience at a previous firm' } as const;
---
<BaseLayout
  title="M&A and Transformation Experience"
  description="Anonymized examples of integration, separation, value creation and go-to-market work across healthcare, life sciences, industrials and business services."
  schema={[breadcrumbSchema(crumbs)]}
>
  <PageHero
    kicker="Experience"
    title="Selected experience"
    lede="A selection of the work we have done. Client names and confidential details are not included, and we do not publish financial results."
    crumbs={crumbs}
  />

  <section class="section-tight border-b border-rule" aria-label="How to read these examples">
    <div class="container-site grid gap-8 md:grid-cols-12">
      <p class="text-ink-soft md:col-span-7">
        Each example is labelled with its context. <strong class="text-ink">Samsara Ventures engagements</strong> were delivered by the firm. Examples marked as <strong class="text-ink">prior experience</strong> describe work our founder led at previous advisory firms; they were not engagements of Samsara Ventures.
      </p>
      <nav aria-label="Jump to" class="md:col-span-4 md:col-start-9">
        <ul class="font-sans text-[0.98rem]">
          {experienceGroups.map((g) => <li class="border-t border-rule py-2.5 last:border-b"><a href={`#${g.id}`} class="no-underline hover:underline">{g.title}</a></li>)}
        </ul>
      </nav>
    </div>
  </section>

  {experienceGroups.map((group, gi) => (
    <section id={group.id} class:list={['section', gi % 2 === 1 && 'bg-stone']} aria-labelledby={`${group.id}-title`}>
      <div class="container-site grid gap-10 md:grid-cols-12">
        <div class="md:col-span-4">
          <h2 id={`${group.id}-title`} class="text-h2">{group.title}</h2>
          <p class="mt-4 text-ink-soft">{group.intro}</p>
        </div>
        <div class="space-y-14 md:col-span-8">
          {group.items.map((item) => (
            <article class="border-t-2 border-ink pt-6">
              <p class="flex flex-wrap gap-x-4 gap-y-1 font-sans text-[0.92rem]">
                <span class:list={[item.context === 'samsara' ? 'text-red' : 'text-ink-soft']}>{label[item.context]}</span>
                <span class="text-ink-muted">{item.industry}</span>
              </p>
              <h3 class="mt-3 text-[1.4rem] leading-snug">{item.title}</h3>
              <dl class="mt-5 grid gap-5 sm:grid-cols-2">
                <div><dt class="font-sans text-[0.95rem] font-medium">The challenge</dt><dd class="mt-1.5 text-[1rem] text-ink-soft">{item.challenge}</dd></div>
                <div><dt class="font-sans text-[0.95rem] font-medium">Our role</dt><dd class="mt-1.5 text-[1rem] text-ink-soft">{item.support}</dd></div>
              </dl>
              <ul class="mt-5 flex flex-wrap gap-2" aria-label="Capabilities">
                {item.capabilities.map((c) => <li class="rounded-full border border-rule bg-white px-3 py-1 font-sans text-[0.85rem] text-ink-soft">{c}</li>)}
              </ul>
              {site.showDrafts && item.confirm && (
                <p class="mt-4 rounded-md border border-[#f0d58a] bg-[#fff4d6] px-3 py-2 font-sans text-[0.85rem] text-[#6b4a00]">To confirm: {item.confirm}</p>
              )}
            </article>
          ))}
        </div>
      </div>
    </section>
  ))}

  <section class="on-dark section bg-ink text-white" aria-labelledby="industries-title">
    <div class="container-site grid gap-12 md:grid-cols-12">
      <div class="md:col-span-5">
        <h2 id="industries-title" class="text-h2 text-white">Industries</h2>
        <p class="mt-4 text-white/75">The industries represented in the examples above. We also work with companies in other sectors.</p>
      </div>
      <ul class="font-sans text-[1.1rem] md:col-span-6 md:col-start-7">
        {industries.map((i) => <li class="border-t border-white/15 py-3.5 last:border-b">{i}</li>)}
      </ul>
    </div>
  </section>

  <section class="section-tight" aria-labelledby="explore-title">
    <div class="container-site">
      <h2 id="explore-title" class="text-h3">Explore our services</h2>
      <ul class="mt-5 flex flex-wrap gap-x-8 gap-y-3">
        {services.map((s) => <li><a href={s.href} class="link-arrow text-[1.1rem]">{s.name}</a></li>)}
      </ul>
    </div>
  </section>

  <CTABand title="Facing a similar situation?" text="We are happy to discuss how our experience could apply to your transaction or program." primaryLabel="Schedule a Conversation" />
</BaseLayout>
