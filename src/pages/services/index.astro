---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/PageHero.astro';
import SectionHead from '@/components/SectionHead.astro';
import Lifecycle from '@/components/Lifecycle.astro';
import CTABand from '@/components/CTABand.astro';
import { services } from '@/data/services';
import { breadcrumbSchema } from '@/utils/schema';

const crumbs = [{ name: 'Home', href: '/' }, { name: 'Services', href: '/services/' }];

const models = [
  { title: 'Focused projects', text: 'A defined scope with clear deliverables, such as IT due diligence on a target, a separation plan or a go-to-market strategy.' },
  { title: 'Program leadership', text: 'Leading an integration management office, separation program or execution PMO for its duration, alongside your team.' },
  { title: 'Interim and embedded support', text: 'Stepping into a portfolio company or business unit to lead a critical agenda until permanent capability is in place.' },
];
---
<BaseLayout
  title="M&A, Value Creation & Growth Strategy Services"
  description="Transaction advisory, value creation and transformation, and growth strategy services for private equity firms, portfolio companies and corporate leaders."
  schema={[breadcrumbSchema(crumbs)]}
>
  <PageHero
    kicker="Services"
    title="Advisory across the deal and transformation lifecycle."
    lede="We help private equity firms and corporate leaders with diligence, integrations and separations, value creation, and growth strategy. Each area is described below."
    crumbs={crumbs}
  />

  <section class="section" aria-labelledby="pillars-title">
    <div class="container-site">
      <h2 id="pillars-title" class="sr-only">Practice areas</h2>
      <div class="divide-y divide-rule border-y border-rule">
        {services.map((s) => (
          <article class="grid gap-6 py-12 md:grid-cols-12 md:gap-10">
            <div class="md:col-span-4">
              <h3 class="text-[1.8rem]"><a href={s.href} class="text-ink no-underline hover:text-red">{s.name}</a></h3>
            </div>
            <div class="md:col-span-5">
              <p class="text-ink-soft">{s.summary}</p>
              <a href={s.href} class="link-arrow mt-5 inline-block" aria-label={`Explore ${s.name}`}>Explore {s.name}</a>
            </div>
            <ul class="font-sans text-[0.97rem] text-ink-soft md:col-span-3">
              {s.highlights.map((h) => <li class="py-1">{h}</li>)}
            </ul>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="on-dark section bg-ink text-white" aria-labelledby="lifecycle-title">
    <div class="container-site">
      <SectionHead id="lifecycle-title" title="With you across the deal lifecycle" intro="We can support a deal at any stage, from early diligence on a target through to preparing the business for sale. Select a stage to see how we can help." dark />
      <Lifecycle />
    </div>
  </section>

  <section class="section" aria-labelledby="models-title">
    <div class="container-site">
      <SectionHead id="models-title" title="How we engage" intro="We can work with you in a few different ways, depending on what you need and how involved you want us to be." />
      <div class="grid gap-10 md:grid-cols-3">
        {models.map((m) => (
          <div class="border-t-2 border-ink pt-6">
            <h3 class="text-h3">{m.title}</h3>
            <p class="mt-3 text-ink-soft">{m.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <CTABand />
</BaseLayout>
