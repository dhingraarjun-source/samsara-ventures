---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/PageHero.astro';
import SectionHead from '@/components/SectionHead.astro';
import Lifecycle from '@/components/Lifecycle.astro';
import CTABand from '@/components/CTABand.astro';
import { services } from '@/data/services';
import { breadcrumbSchema } from '@/utils/schema';

const crumbs = [{ name: 'Home', href: '/' }, { name: 'Services', href: '/services/' }];

const models = [
  { title: 'Focused projects', text: 'A defined scope with clear deliverables, such as IT due diligence on a target, a separation plan or a go-to-market strategy.' },
  { title: 'Program leadership', text: 'Leading an integration management office, separation program or execution PMO for its duration, alongside your team.' },
  { title: 'Interim and embedded support', text: 'Stepping into a portfolio company or business unit to lead a critical agenda until permanent capability is in place.' },
];
---
<BaseLayout
  title="M&A, Value Creation & Growth Strategy Services"
  description="Transaction advisory, value creation and transformation, and growth strategy services for private equity firms, portfolio companies and corporate leaders."
  schema={[breadcrumbSchema(crumbs)]}
>
  <PageHero
    kicker="Services"
    title="Advisory across the deal and transformation lifecycle."
    lede="We help private equity firms and corporate leaders with diligence, integrations and separations, value creation, and growth strategy. Compare the three areas below to find the right starting point."
    crumbs={crumbs}
  />

  <section class="section" aria-labelledby="compare-title">
    <div class="container-site">
      <h2 id="compare-title" class="text-h2">Compare our services</h2>
      <div class="mt-10 grid gap-12 lg:grid-cols-3 lg:gap-x-10 lg:gap-y-0">
        {services.map((s) => (
          <article class="compare grid border-t-[3px] border-red pt-6 lg:row-span-5 lg:grid-rows-subgrid">
            <h3 class="text-[1.6rem]"><a href={s.href} class="text-ink no-underline hover:text-red">{s.name}</a></h3>
            <p class="mt-3 text-ink-soft">{s.summary}</p>
            <div class="mt-6">
              <p class="font-sans text-[0.9rem] font-medium text-red">When to call us</p>
              <p class="mt-1">{s.trigger}</p>
            </div>
            <div class="mt-6">
              <p class="font-sans text-[0.9rem] font-medium text-red">Sample output</p>
              <p class="mt-1">{s.sampleOutput}</p>
            </div>
            <a href={s.href} class="link-arrow mt-6 self-end">Explore {s.name}</a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section bg-stone" aria-labelledby="models-title">
    <div class="container-site">
      <SectionHead id="models-title" title="How we engage" intro="Any of the three services can be delivered in one of these ways, depending on what you need and how involved you want us to be." />
      <div class="grid gap-10 md:grid-cols-3">
        {models.map((m) => (
          <div class="border-t-2 border-ink pt-6">
            <h3 class="text-h3">{m.title}</h3>
            <p class="mt-3 text-ink-soft">{m.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="on-dark section bg-ink text-white" aria-labelledby="lifecycle-title">
    <div class="container-site">
      <SectionHead id="lifecycle-title" title="Or explore by deal stage" intro="If it is easier to start from where you are in a transaction, select a stage to see how we can help." dark />
      <Lifecycle />
    </div>
  </section>

  <CTABand />
</BaseLayout>
