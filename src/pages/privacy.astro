---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/PageHero.astro';
import { site, providers } from '@/config/site';
import { breadcrumbSchema } from '@/utils/schema';
const crumbs = [{ name: 'Home', href: '/' }, { name: 'Privacy', href: '/privacy/' }];
---
<BaseLayout
  title="Privacy Notice"
  description="How Samsara Ventures handles information submitted through this website."
  schema={[breadcrumbSchema(crumbs)]}
>
  <PageHero title="Privacy notice" lede="How we handle information you share with us through this website." crumbs={crumbs} />
  <section class="section">
    <div class="container-site">
      <div class="prose-site">
        <h2>Information you send us</h2>
        <p>When you use the contact form, we receive the details you enter: your name and email address, your message, and your company and area of interest if you provide them. We use this information only to respond to your inquiry and to continue a conversation you have started.</p>
        <p>
          {providers.form && <>Contact form submissions are processed by {providers.form}, a form handling service, which forwards them to our email. </>}
          If you schedule a conversation, your booking is handled by {providers.booking}. Each of these services processes data under its own privacy policy.
        </p>
        <h2>What we do not do</h2>
        <ul>
          <li>We do not sell or rent your information.</li>
          <li>We do not add you to marketing lists without your permission.</li>
          <li>This website does not use advertising or tracking cookies.</li>
        </ul>
        <h2>Confidential information</h2>
        <p>Please do not send confidential or material non-public deal information through the contact form. If an engagement requires it, we will agree an appropriate way to share information securely.</p>
        <h2>Your choices</h2>
        <p>You can ask us to update or delete the information you have sent us at any time by emailing <a href={`mailto:${site.email}`}>{site.email}</a>.</p>
      </div>
    </div>
  </section>
</BaseLayout>
