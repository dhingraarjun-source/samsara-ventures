---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/PageHero.astro';
import CTABand from '@/components/CTABand.astro';
import { insightCategories } from '@/content.config';
import { getVisibleInsights, isLive, readingTime, formatDate } from '@/utils/insights';
import { breadcrumbSchema } from '@/utils/schema';

const articles = await getVisibleInsights();
const crumbs = [{ name: 'Home', href: '/' }, { name: 'Insights', href: '/insights/' }];
const ordered = articles.some((a) => a.data.readingOrder);
---
<BaseLayout
  title="Insights on M&A and Value Creation"
  description="Practical perspectives on IT due diligence, post-merger integration, carve-outs, private equity value creation and growth strategy from Samsara Ventures."
  schema={[breadcrumbSchema(crumbs)]}
>
  <PageHero
    kicker="Insights"
    title="Insights"
    lede="Articles on transactions, value creation, technology transformation and growth, written for private equity firms, corporate development teams and the executives leading these programs."
    crumbs={crumbs}
  />

  <section class="section" aria-labelledby="articles-title">
    <div class="container-site">
      {articles.length > 0 ? (
        <>
          <div class="mb-10 max-w-2xl">
            <h2 id="articles-title" class="text-h2">{ordered ? 'Suggested reading order' : 'Articles'}</h2>
            {ordered && <p class="mt-3 text-ink-soft">The articles follow a deal from diligence through integration to the hold period. Start at the beginning, or jump to the stage you are in.</p>}
          </div>
          <ol class="divide-y divide-rule border-y border-rule">
            {articles.map((a, i) => (
              <li class="grid gap-4 py-10 md:grid-cols-12 md:gap-10">
                <div class="font-sans md:col-span-2">
                  {ordered && <span class="block text-[2.2rem] font-light leading-none text-red" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>}
                  <span class="mt-2 block text-[0.9rem] text-ink-muted">{a.data.category}</span>
                </div>
                <div class="md:col-span-7">
                  <h3 class="text-[1.45rem] leading-snug">
                    <a href={`/insights/${a.id}/`} class="text-ink no-underline hover:text-red hover:underline">{a.data.title}</a>
                  </h3>
                  {a.data.useWhen && <p class="mt-3"><span class="font-sans font-medium">Read this when </span>{a.data.useWhen.charAt(0).toLowerCase() + a.data.useWhen.slice(1)}</p>}
                  <p class="mt-2 text-ink-soft">{a.data.description}</p>
                </div>
                <p class="font-sans text-[0.92rem] text-ink-muted md:col-span-3 md:text-right">
                  {isLive(a) && a.data.publishDate
                    ? <time datetime={a.data.publishDate.toISOString()}>{formatDate(a.data.publishDate)}</time>
                    : <span class="draft-badge">Draft, not published</span>}
                  <span class="block">{readingTime(a.body)}</span>
                </p>
              </li>
            ))}
          </ol>
        </>
      ) : (
        <div class="max-w-2xl">
          <h2 id="articles-title" class="text-h2">Articles</h2>
          <p class="mt-4 text-lede text-ink-soft">Our first articles are in preparation. They will cover IT due diligence, post-merger integration and value creation execution.</p>
          <h3 class="mt-10 text-h3">Topics we write about</h3>
          <ul class="rule-list mt-4 font-sans">
            {insightCategories.map((c) => <li>{c}</li>)}
          </ul>
          <p class="mt-8">In the meantime, explore our <a href="/services/">services</a> and <a href="/experience/">experience</a>, or <a href="/contact/">start a conversation</a>.</p>
        </div>
      )}
    </div>
  </section>

  <CTABand title="Have a question about your own situation?" text="We are happy to talk through how any of this applies to a deal or program you are working on." primaryLabel="Schedule a Conversation" />
</BaseLayout>

<style>
  .draft-badge { display: inline-block; background: #fff4d6; color: #6b4a00; border: 1px solid #f0d58a; padding: .15rem .6rem; border-radius: 999px; font-size: .85rem; }
</style>
