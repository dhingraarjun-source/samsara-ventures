---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/PageHero.astro';
import CTABand from '@/components/CTABand.astro';
import { insightCategories } from '@/content.config';
import { getVisibleInsights, isLive, readingTime, formatDate } from '@/utils/insights';
import { breadcrumbSchema } from '@/utils/schema';

const articles = await getVisibleInsights();
const crumbs = [{ name: 'Home', href: '/' }, { name: 'Insights', href: '/insights/' }];
const counts = Object.fromEntries(insightCategories.map((c) => [c, articles.filter((a) => a.data.category === c).length]));
---
<BaseLayout
  title="Insights on M&A and Value Creation"
  description="Practical perspectives on IT due diligence, post-merger integration, carve-outs, private equity value creation and growth strategy from Samsara Ventures."
  schema={[breadcrumbSchema(crumbs)]}
>
  <PageHero
    kicker="Insights"
    title="Insights"
    lede="Articles on transactions, value creation, technology transformation and growth, written for private equity firms, corporate development teams and the executives leading these programs."
    crumbs={crumbs}
  />

  <section class="section" aria-labelledby="articles-title">
    <div class="container-site">
      <h2 id="articles-title" class="sr-only">Articles</h2>

      {articles.length > 0 && (
        <div class="mb-12 flex flex-wrap gap-2" role="group" aria-label="Filter by category" data-filters>
          <button type="button" class="chip" aria-pressed="true" data-cat="all">All</button>
          {insightCategories.map((c) => (
            <button type="button" class="chip" aria-pressed="false" data-cat={c} disabled={counts[c] === 0}>{c}</button>
          ))}
        </div>
      )}

      {articles.length > 0 ? (
        <ul class="grid gap-x-12 gap-y-4 md:grid-cols-2" data-articles>
          {articles.map((a) => (
            <li class="article-item border-t border-rule py-8" data-cat={a.data.category}>
              <p class="font-sans text-[0.92rem] text-ink-muted">
                <span class="text-red">{a.data.category}</span>
                <span aria-hidden="true"> &middot; </span>
                {readingTime(a.body)}
              </p>
              <h3 class="mt-3 text-[1.45rem] leading-snug">
                <a href={`/insights/${a.id}/`} class="text-ink no-underline hover:text-red">{a.data.title}</a>
              </h3>
              <p class="mt-3 text-ink-soft">{a.data.description}</p>
              <p class="mt-4 font-sans text-[0.92rem] text-ink-muted">
                {isLive(a) && a.data.publishDate
                  ? <time datetime={a.data.publishDate.toISOString()}>{formatDate(a.data.publishDate)}</time>
                  : <span class="draft-badge">Draft, not published</span>}
              </p>
            </li>
          ))}
        </ul>
      ) : (
        <div class="max-w-2xl">
          <p class="text-lede text-ink-soft">Our first articles are in preparation. They will cover IT due diligence, post-merger integration and value creation execution.</p>
          <h3 class="mt-10 text-h3">Topics we write about</h3>
          <ul class="rule-list mt-4 font-sans">
            {insightCategories.map((c) => <li>{c}</li>)}
          </ul>
          <p class="mt-8">In the meantime, explore our <a href="/services/">services</a> and <a href="/experience/">experience</a>, or <a href="/contact/">start a conversation</a>.</p>
        </div>
      )}

    </div>
  </section>

  <CTABand title="Have a question about your own situation?" text="We are happy to talk through how any of this applies to a deal or program you are working on." primaryLabel="Schedule a Conversation" />
</BaseLayout>

<style>
  .chip { font-family: var(--font-sans); font-size: .95rem; padding: .5rem 1rem; border-radius: 999px; border: 1.5px solid var(--color-rule); color: var(--color-ink); background: #fff; cursor: pointer; transition: border-color .2s, background-color .2s, color .2s; }
  .chip:hover:not(:disabled) { border-color: var(--color-ink); }
  .chip[aria-pressed='true'] { background: var(--color-ink); border-color: var(--color-ink); color: #fff; }
  .chip:disabled { opacity: .45; cursor: not-allowed; }
  .draft-badge { display: inline-block; background: #fff4d6; color: #6b4a00; border: 1px solid #f0d58a; padding: .15rem .6rem; border-radius: 999px; font-size: .85rem; }
</style>

<script>
  const group = document.querySelector('[data-filters]');
  const items = document.querySelectorAll<HTMLElement>('[data-articles] [data-cat]');
  group?.addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('button[data-cat]');
    if (!btn || btn.disabled) return;
    group.querySelectorAll('button').forEach((b) => b.setAttribute('aria-pressed', String(b === btn)));
    const cat = btn.dataset.cat;
    items.forEach((it) => { it.hidden = cat !== 'all' && it.dataset.cat !== cat; });
  });
</script>
