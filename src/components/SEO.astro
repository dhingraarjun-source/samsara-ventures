---
/**
 * Page metadata: title, description, canonical, Open Graph, Twitter and JSON-LD.
 * Every page passes its own title and description through BaseLayout.
 */
import { site } from '@/config/site';
import { organizationSchema } from '@/utils/schema';

export interface Props {
  title: string;
  description: string;
  image?: string;
  type?: 'website' | 'article';
  noindex?: boolean;
  schema?: Record<string, unknown>[];
}

const { title, description, image = site.ogImage, type = 'website', noindex = false, schema = [] } = Astro.props;
const canonical = new URL(Astro.url.pathname, site.url).href;
const ogImage = new URL(image, site.url).href;
const fullTitle = title.includes(site.name) ? title : `${title} | ${site.name}`;
const jsonLd = [organizationSchema(), ...schema];
---
<title>{fullTitle}</title>
<meta name="description" content={description} />
{noindex ? <meta name="robots" content="noindex, nofollow" /> : <link rel="canonical" href={canonical} />}

<meta property="og:type" content={type} />
<meta property="og:site_name" content={site.name} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogImage} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />

{jsonLd.map((data) => <script type="application/ld+json" set:html={JSON.stringify(data)} />)}
