---
/**
 * Contact form. Submissions go to the Formspree endpoint set in src/config/site.ts
 * (or PUBLIC_FORM_ENDPOINT). If no endpoint is set, visitors see the email address instead.
 *
 * Without JavaScript the form posts directly to the endpoint and the browser's
 * built-in validation applies (name, email and message are required).
 * With JavaScript it submits in the background, keeps entered values if sending fails,
 * and moves focus to a confirmation message when it succeeds.
 */
import { site } from '@/config/site';
const areas = [
  'Due diligence',
  'M&A integration',
  'Carve-out or separation',
  'Value creation and transformation',
  'Growth and commercial strategy',
  'Something else',
];
---
{site.formEndpoint ? (
  <div class="contact-form-wrap" data-email={site.email}>
    <form id="contact-form" action={site.formEndpoint} method="POST" data-endpoint={site.formEndpoint} aria-describedby="cf-required-note">
      <p id="cf-required-note" class="mb-5 font-sans text-[0.9rem] text-ink-muted">Name, email and message are required.</p>
      <div class="grid gap-5 sm:grid-cols-2">
        <div class="field">
          <label for="cf-name">Name</label>
          <input id="cf-name" name="name" type="text" autocomplete="name" required maxlength="120" aria-describedby="cf-name-err" />
          <p id="cf-name-err" class="err" hidden>Enter your name.</p>
        </div>
        <div class="field">
          <label for="cf-company">Company <span class="opt">(optional)</span></label>
          <input id="cf-company" name="company" type="text" autocomplete="organization" maxlength="160" />
        </div>
      </div>
      <div class="field">
        <label for="cf-email">Work email</label>
        <input id="cf-email" name="email" type="email" autocomplete="email" required maxlength="200" aria-describedby="cf-email-err" />
        <p id="cf-email-err" class="err" hidden>Enter a valid email address, such as name@company.com, so we can reply.</p>
      </div>
      <div class="field">
        <label for="cf-area">Area of interest <span class="opt">(optional)</span></label>
        <select id="cf-area" name="area_of_interest">
          <option value="">Select one</option>
          {areas.map((a) => <option>{a}</option>)}
        </select>
      </div>
      <div class="field">
        <label for="cf-message">Message</label>
        <textarea id="cf-message" name="message" rows="6" required maxlength="5000" aria-describedby="cf-message-hint cf-message-err"></textarea>
        <p id="cf-message-hint" class="hint">A few lines on the situation and what you are looking for. Please do not include confidential or sensitive deal information.</p>
        <p id="cf-message-err" class="err" hidden>Add a short message so we know how to help.</p>
      </div>

      <!-- Default subject for no-JavaScript submissions; replaced with a more specific one when JavaScript runs. -->
      <input type="hidden" name="_subject" value="Website inquiry" />
      <!-- Spam protection: hidden honeypot field. Formspree discards submissions that fill it in. -->
      <div class="hp" aria-hidden="true">
        <label for="cf-gotcha">Leave this field empty</label>
        <input id="cf-gotcha" type="text" name="_gotcha" tabindex="-1" autocomplete="off" />
      </div>

      <p class="mt-2 font-sans text-[0.88rem] text-ink-muted">
        We use your details only to respond to your inquiry. See our <a href="/privacy/">privacy notice</a>.
      </p>
      <button type="submit" class="btn btn-primary mt-6">Send message</button>
      <p class="form-error mt-5 font-sans" role="alert" hidden></p>
    </form>

    <div class="sent" hidden>
      <h3 class="text-h3" tabindex="-1">Message sent</h3>
      <p class="mt-2 text-ink-soft" data-sent-text></p>
    </div>
    <!-- Persistent live region so screen readers announce the outcome even when the form is hidden. -->
    <p class="sr-only" role="status" aria-live="polite" data-announce></p>
  </div>
) : (
  <div class="rounded-xl border border-rule p-8">
    <p class="text-lede">Email us at <a href={`mailto:${site.email}`}>{site.email}</a> and we will respond directly.</p>
  </div>
)}

<style>
  .field { margin-top: 1.25rem; }
  .grid .field { margin-top: 0; }
  label { display: block; font-family: var(--font-sans); font-weight: 500; font-size: .98rem; margin-bottom: .4rem; }
  .opt { font-weight: 400; color: var(--color-ink-muted); }
  input, select, textarea {
    width: 100%; font: inherit; font-size: 1rem; color: var(--color-ink); background: #fff;
    border: 1.5px solid var(--color-rule); border-radius: 8px; padding: .75rem .9rem; transition: border-color .15s, box-shadow .15s;
  }
  textarea { resize: vertical; min-height: 9rem; }
  input:hover, select:hover, textarea:hover { border-color: #cdbdb9; }
  input:focus, select:focus, textarea:focus { outline: none; border-color: var(--color-ink); box-shadow: 0 0 0 3px rgb(204 19 6 / .25); }
  [aria-invalid='true'] { border-color: var(--color-red) !important; }
  .hint { font-size: .9rem; color: var(--color-ink-muted); margin-top: .4rem; }
  .err { font-family: var(--font-sans); font-size: .9rem; color: var(--color-red-deep); margin-top: .4rem; }
  .form-error { color: var(--color-red-deep); }
  .hp { position: absolute !important; left: -10000px; width: 1px; height: 1px; overflow: hidden; }
  .sent { padding: 2rem; border-radius: 12px; background: var(--color-stone); }
  .sent h3:focus { outline: none; }
  .sent h3:focus-visible { outline: 3px solid var(--color-red); outline-offset: 4px; }
  button[aria-disabled='true'] { opacity: .7; cursor: progress; }
</style>

<script>
  const wrap = document.querySelector<HTMLElement>('.contact-form-wrap');
  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  if (wrap && form) {
    // JavaScript is running, so use custom validation messages instead of the browser's.
    form.noValidate = true;
    const email = wrap.dataset.email ?? '';
    const endpoint = form.dataset.endpoint!;
    const button = form.querySelector<HTMLButtonElement>('button[type=submit]')!;
    const errorBox = form.querySelector<HTMLElement>('.form-error')!;
    const announce = wrap.querySelector<HTMLElement>('[data-announce]')!;
    const sent = wrap.querySelector<HTMLElement>('.sent')!;
    const emailRe = /^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/;

    // Only these fields are required.
    const rules: Record<string, (v: string) => boolean> = {
      name: (v) => v.length > 0,
      email: (v) => emailRe.test(v),
      message: (v) => v.length > 0,
    };
    const field = (name: string) => form.elements.namedItem(name) as HTMLInputElement;
    const value = (name: string) => field(name).value.trim();

    function setValidity(el: HTMLInputElement, valid: boolean) {
      el.setAttribute('aria-invalid', String(!valid));
      const err = document.getElementById(`${el.id}-err`);
      if (err) err.hidden = valid;
    }

    function validate(): boolean {
      let first: HTMLElement | null = null;
      for (const [name, ok] of Object.entries(rules)) {
        const valid = ok(value(name));
        setValidity(field(name), valid);
        if (!valid && !first) first = field(name);
      }
      first?.focus();
      return !first;
    }

    form.addEventListener('input', (e) => {
      const el = e.target as HTMLInputElement;
      if (el.getAttribute('aria-invalid') === 'true' && rules[el.name]?.(el.value.trim())) setValidity(el, true);
    });

    function subjectLine(): string {
      const company = value('company');
      const area = value('area_of_interest');
      let subject = `Website inquiry from ${value('name')}`;
      if (company) subject += ` (${company})`;
      if (area) subject += `: ${area}`;
      return subject;
    }

    let sending = false;
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (sending) return;
      errorBox.hidden = true;
      errorBox.textContent = '';
      if (!validate()) return;

      const data = new FormData(form);
      data.set('_subject', subjectLine());
      sending = true;
      button.setAttribute('aria-disabled', 'true');
      form.setAttribute('aria-busy', 'true');
      button.textContent = 'Sending...';
      announce.textContent = 'Sending your message.';
      try {
        const res = await fetch(endpoint, { method: 'POST', body: data, headers: { Accept: 'application/json' } });
        if (!res.ok) throw new Error(String(res.status));
        sent.querySelector('[data-sent-text]')!.textContent = `Thank you. We will reply to ${value('email')} shortly.`;
        form.hidden = true;
        sent.hidden = false;
        announce.textContent = 'Message sent. Thank you, we will reply shortly.';
        sent.querySelector<HTMLElement>('h3')!.focus();
      } catch {
        // Keep everything the visitor typed so they can try again.
        errorBox.textContent = `Your message could not be sent. Please try again, or email ${email} directly.`;
        errorBox.hidden = false;
        announce.textContent = '';
        button.focus();
      } finally {
        sending = false;
        button.removeAttribute('aria-disabled');
        form.removeAttribute('aria-busy');
        button.textContent = 'Send message';
      }
    });
  }
</script>
