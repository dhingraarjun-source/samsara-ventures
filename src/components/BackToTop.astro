---
/** Floating "back to top" button on every page. Appears after the visitor scrolls down about half a screen. */
---
<button type="button" class="back-to-top" aria-label="Back to top" hidden>
  <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true" focusable="false">
    <path d="M12 19V5M5 12l7-7 7 7" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" />
  </svg>
</button>

<style>
  .back-to-top {
    position: fixed; right: 1.25rem; bottom: 1.25rem; z-index: 40;
    width: 48px; height: 48px; border-radius: 50%;
    display: grid; place-items: center;
    background: var(--color-red); color: #fff;
    box-shadow: 0 8px 20px -10px rgb(60 0 0 / .6);
    cursor: pointer; opacity: 0; transform: translateY(8px);
    transition: opacity .2s, transform .2s, background-color .2s;
  }
  .back-to-top.is-visible { opacity: 1; transform: none; }
  .back-to-top:hover { background: var(--color-red-deep); }
  .back-to-top:focus-visible { outline: 3px solid var(--color-ink); outline-offset: 3px; }
  @media (min-width: 768px) { .back-to-top { right: 2rem; bottom: 2rem; } }
</style>

<script>
  const btn = document.querySelector<HTMLButtonElement>('.back-to-top');
  if (btn) {
    let hideTimer: number | undefined;
    const update = () => {
      const show = window.scrollY > window.innerHeight * 0.5;
      if (show) {
        window.clearTimeout(hideTimer);
        btn.hidden = false;
        requestAnimationFrame(() => btn.classList.add('is-visible'));
      } else if (!btn.hidden) {
        btn.classList.remove('is-visible');
        hideTimer = window.setTimeout(() => { btn.hidden = true; }, 200);
      }
    };
    window.addEventListener('scroll', update, { passive: true });
    update();
    btn.addEventListener('click', () => {
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      window.scrollTo({ top: 0, behavior: reduce ? 'auto' : 'smooth' });
      // Move keyboard focus back to the top of the page as well.
      document.querySelector<HTMLElement>('#site-header .brand')?.focus({ preventScroll: true });
    });
  }
</script>
