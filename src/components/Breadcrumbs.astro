---
import type { Crumb } from '@/utils/schema';
export interface Props { crumbs: Crumb[] }
const { crumbs } = Astro.props;
---
<nav aria-label="Breadcrumb" class="font-sans text-[0.92rem] text-ink-muted">
  <ol class="flex flex-wrap items-center gap-x-2 gap-y-1">
    {crumbs.map((c, i) => (
      <li class="flex items-center gap-2">
        {i > 0 && <span aria-hidden="true" class="text-rule">/</span>}
        {i < crumbs.length - 1
          ? <a href={c.href} class="text-ink-soft no-underline hover:text-red hover:underline">{c.name}</a>
          : <span aria-current="page" class="text-ink">{c.name}</span>}
      </li>
    ))}
  </ol>
</nav>
