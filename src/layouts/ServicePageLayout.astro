---
/** Shared template for the three service detail pages. Content comes from src/data/services.ts. */
import BaseLayout from './BaseLayout.astro';
import PageHero from '@/components/PageHero.astro';
import CTABand from '@/components/CTABand.astro';
import { services, type Service } from '@/data/services';
import { site } from '@/config/site';
import { breadcrumbSchema, serviceSchema } from '@/utils/schema';
import { getPublishedInsights } from '@/utils/insights';

export interface Props { service: Service }
const { service } = Astro.props;
const crumbs = [
  { name: 'Home', href: '/' },
  { name: 'Services', href: '/services/' },
  { name: service.name, href: service.href },
];
const others = services.filter((s) => s.slug !== service.slug);
const insights = (await getPublishedInsights()).filter((a) => service.relatedInsights.includes(a.id));
---
<BaseLayout
  title={service.meta.title}
  description={service.meta.description}
  schema={[breadcrumbSchema(crumbs), serviceSchema(service.name, service.meta.description, service.href)]}
>
  <PageHero kicker={service.name} title={service.hero.title} lede={service.hero.lede} crumbs={crumbs}>
    <div class="mt-9 flex flex-wrap gap-3">
      <a href={site.bookingUrl} class="btn btn-primary" target="_blank" rel="noopener">Schedule a Conversation</a>
      <a href="#capabilities" class="btn btn-outline">View capabilities</a>
    </div>
  </PageHero>

  <!-- Context and client challenges -->
  <section class="section" aria-labelledby="context">
    <div class="container-site grid gap-12 md:grid-cols-12">
      <div class="md:col-span-6">
        <h2 id="context" class="text-h2">{service.context.title}</h2>
        <p class="mt-6 text-ink-soft">{service.context.paragraphs[0]}</p>
      </div>
      <div class="md:col-span-5 md:col-start-8">
        <h3 class="text-h3">Challenges we are brought in to solve</h3>
        <ul class="rule-list mt-6">
          {service.context.challenges.map((c) => <li class="text-[1.02rem]">{c}</li>)}
        </ul>
      </div>
    </div>
  </section>

  <!-- Entry points: the decision and what we produce for it -->
  <section class="section-tight border-t border-rule" aria-labelledby="tracks">
    <div class="container-site">
      <h2 id="tracks" class="text-h2">Where we help</h2>
      <div class:list={['mt-10 grid gap-10', service.tracks.length === 3 ? 'lg:grid-cols-3' : 'md:grid-cols-2']}>
        {service.tracks.map((t) => (
          <article class="border-t-2 border-ink pt-5">
            <h3 class="text-h3">{t.title}</h3>
            <p class="mt-4 font-sans text-[0.9rem] font-medium text-red">The decision</p>
            <p class="mt-1 text-[1rem]">{t.decision}</p>
            <p class="mt-4 font-sans text-[0.9rem] font-medium text-red">What you get</p>
            <ul class="mt-1 space-y-1.5 text-[1rem] text-ink-soft">
              {t.outputs.map((o) => <li class="relative pl-4 before:absolute before:left-0 before:top-[0.7em] before:h-1.5 before:w-1.5 before:rounded-full before:bg-red">{o}</li>)}
            </ul>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Capabilities and situations -->
  <section class="section-tight bg-stone" aria-labelledby="capabilities">
    <div class="container-site grid gap-14 md:grid-cols-2 md:gap-16">
      <div>
        <h2 id="capabilities" class="text-h2">Capabilities</h2>
        <p class="mt-3 text-ink-soft">Select one to see what it covers.</p>
        <ul class="mt-6 border-t border-rule">
          {service.capabilities.map((c) => (
            <li class="border-b border-rule">
              <details class="cap group">
                <summary class="flex cursor-pointer list-none items-center justify-between gap-4 py-3.5 font-sans text-[1.05rem] font-medium">
                  {c.title}
                  <span class="cap-icon text-red" aria-hidden="true">+</span>
                </summary>
                <p class="pb-4 text-[1rem] text-ink-soft">{c.text}</p>
              </details>
            </li>
          ))}
        </ul>
      </div>
      <div>
        <h2 class="text-h2">Situations where we can help</h2>
        <ul class="rule-list mt-6">
          {service.situations.map((x) => <li>{x}</li>)}
        </ul>
      </div>
    </div>
  </section>

  <!-- Related -->
  <section class="section-tight" aria-labelledby="related">
    <div class="container-site grid gap-12 md:grid-cols-12">
      <div class="md:col-span-5">
        <h2 id="related" class="text-h2">Related services</h2>
        <ul class="rule-list mt-6">
          {others.map((o) => (
            <li><a href={o.href} class="link-arrow text-[1.1rem]">{o.name}</a><p class="mt-1 text-[0.98rem] text-ink-soft">{o.summary}</p></li>
          ))}
        </ul>
      </div>
      <div class="md:col-span-6 md:col-start-7">
        <h2 class="text-h2">Related insights</h2>
        {insights.length > 0 ? (
          <ul class="rule-list mt-6">
            {insights.map((a) => (
              <li><a href={`/insights/${a.id}/`} class="link-arrow text-[1.1rem]">{a.data.title}</a><p class="mt-1 text-[0.98rem] text-ink-soft">{a.data.description}</p></li>
            ))}
          </ul>
        ) : (
          <p class="mt-6 text-ink-soft">Articles on this topic are in preparation. In the meantime, see our <a href="/experience/">experience</a> or <a href="/contact/">get in touch</a>.</p>
        )}
      </div>
    </div>
  </section>

  <CTABand />
</BaseLayout>

<style>
  .cap summary::-webkit-details-marker { display: none; }
  .cap-icon { font-size: 1.4rem; line-height: 1; transition: transform .2s; }
  .cap[open] .cap-icon { transform: rotate(45deg); }
  .cap summary:hover { color: var(--color-red); }
</style>
